  },
  "scope": "Hardware contracts of the Linux Arc 130V driver re-expressed as CPU-side plans for a macOS kernel extension. No Linux source file is vendored, no kernel module is loaded, and no Apple driver binary is read or redistributed.",
  "ported_modules": {
    "gpu-prototype/lb_xe2_pat.cpp": "Lunar Lake PAT entry table, register offsets, ordered write plan and readback check, re-expressed as CPU data instead of MMIO calls.",
    "gpu-prototype/lb_lrc.cpp": "Xe2 render/compute LRC allocation layout, context-image dword writes, ring control word, PPGTT root entry, first ring instruction and context descriptor, built into caller-owned memory."
  },
  "not_ported": [
    "Indirect ring state: no graphics descriptor at this pin enables it.",
    "Indirect context page: gt_engine_needs_indirect_ctx() returns false at this pin.",
    "Per-context workaround batch contents; the page is reserved, nothing is emitted.",
    "set_offsets() register lists for context save/restore state.",
    "Memory-based interrupt (MSI-X) context fields.",
    "PXP, run-alone, OA and parallel-submission context features.",
    "Every actual MMIO write, GGTT binding, firmware load and submission.",
    "Execlist submission (RCU_MODE with RCU_MODE_CCS_ENABLE for compute, the write barrier before the MMIO writes, RING_HWS_PGA) and the software context id it ORs into the descriptor.",
    "Parallel scratch and GuC work-queue area inside the PPHWSP page.",
    "Runtime ring accessors: ring_space, ring_head, ring_is_idle and tail publication."
  ],
  "verification": {
    "tests": "tests/test_arc_port.py parses these files and compares the parsed values against the compiled module; expectations are not written into the test.",
    "hardware_tested": false,
    "pat_programmed_on_hardware": false,
    "lrc_submitted": false,
    "gpu_execution_implemented": false,
    "adversarial_review": "A verification pass re-read every claimed constant against these files. It corrected the forcewake scope of the PAT programming path, added the per-address-space PAT index limits, and surfaced the power-of-two ring requirement and the XEHP_SW_CTX_ID descriptor window."
  },
